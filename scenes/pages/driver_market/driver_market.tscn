[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/pages/driver_market/driver_market.gd" id="1_drivers"]
[ext_resource type="PackedScene" path="res://ui/components/decision_comparison_drawer.tscn" id="2_compare"]

[node name="driver_market" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_drivers")

[node name="page_margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="page_layout" type="VBoxContainer" parent="page_margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="page_title" type="Label" parent="page_margin/page_layout"]
theme_type_variation = &"PageTitle"
layout_mode = 2
text = "Driver Hiring"

[node name="current_driver_label" type="Label" parent="page_margin/page_layout"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Current driver"
autowrap_mode = 2

[node name="hiring_status_label" type="Label" parent="page_margin/page_layout"]
theme_type_variation = &"StatusLabel"
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.82, 0.25, 1)
text = "Hiring status"
autowrap_mode = 2

[node name="separator" type="HSeparator" parent="page_margin/page_layout"]
layout_mode = 2

[node name="candidates_heading" type="Label" parent="page_margin/page_layout"]
theme_type_variation = &"SectionTitle"
layout_mode = 2
text = "Available candidates"

[node name="scroll" type="ScrollContainer" parent="page_margin/page_layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="candidates_container" type="VBoxContainer" parent="page_margin/page_layout/scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="confirmation_dialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Confirm driver contract"

[node name="DecisionComparisonDrawer" parent="." instance=ExtResource("2_compare")]
unique_name_in_owner = true
