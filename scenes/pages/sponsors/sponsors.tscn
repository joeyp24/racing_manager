[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/pages/sponsors/sponsors.gd" id="1"]
[ext_resource type="PackedScene" path="res://ui/components/decision_comparison_drawer.tscn" id="2_compare"]

[node name="sponsors" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="PageScroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="margin" type="MarginContainer" parent="PageScroll"]
size_flags_horizontal = 3
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="content" type="VBoxContainer" parent="PageScroll/margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="title" type="Label" parent="PageScroll/margin/content"]
theme_type_variation = &"PageTitle"
layout_mode = 2
text = "Sponsor Offers"

[node name="status_label" type="Label" parent="PageScroll/margin/content"]
theme_type_variation = &"StatusLabel"
unique_name_in_owner = true
layout_mode = 2
text = "Choose one sponsor for this season."

[node name="offers_container" type="VBoxContainer" parent="PageScroll/margin/content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="DecisionComparisonDrawer" parent="." instance=ExtResource("2_compare")]
unique_name_in_owner = true
