[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/command_bar.gd" id="1"]

[node name="CommandBar" type="PanelContainer"]
custom_minimum_size = Vector2(300, 42)
layout_mode = 2
theme_type_variation = &"HeroPanel"
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 3
theme_override_constants/margin_right = 4
theme_override_constants/margin_bottom = 3

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Collapsed" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Summary" type="VBoxContainer" parent="Margin/Content/Collapsed"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1

[node name="NextLabel" type="Label" parent="Margin/Content/Collapsed/Summary"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"EyebrowLabel"
text = "NEXT  ·  Review your team"

[node name="BlockerLabel" type="Label" parent="Margin/Content/Collapsed/Summary"]
unique_name_in_owner = true
layout_mode = 2
text = "•  Loading team status…"
text_overrun_behavior = 3

[node name="ConsequenceLabel" type="Label" parent="Margin/Content/Collapsed/Summary"]
visible = false
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Cost and destination will appear here."
text_overrun_behavior = 3

[node name="ExpandButton" type="Button" parent="Margin/Content/Collapsed"]
unique_name_in_owner = true
layout_mode = 2
text = "List  ▾"

[node name="PrimaryButton" type="Button" parent="Margin/Content/Collapsed"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 32)
layout_mode = 2
theme_type_variation = &"PrimaryButton"
text = "Review"

[node name="Checklist" type="VBoxContainer" parent="Margin/Content"]
visible = false
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 3
