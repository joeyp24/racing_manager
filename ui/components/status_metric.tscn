[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/components/status_metric.gd" id="1"]

[node name="StatusMetric" type="PanelContainer"]
custom_minimum_size = Vector2(112, 50)
layout_mode = 2
focus_mode = 2
theme_type_variation = &"StatusMetricPanel"
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 4

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="EyebrowLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "STATUS"
text_overrun_behavior = 3

[node name="ValueLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"BodyStrong"
text = "Loading"
text_overrun_behavior = 3

[node name="DetailLabel" type="Label" parent="Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Open details"
text_overrun_behavior = 3

[node name="ProgressBar" type="ProgressBar" parent="Margin/Content"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 3)
layout_mode = 2
show_percentage = false
